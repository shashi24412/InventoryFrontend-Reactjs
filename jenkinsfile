pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        APP_DIR = '/var/www/frontend'
        PORT    = '3000'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy to EC2') {
            steps {
                echo "Deploying to ${APP_DIR}..."
                sh """
                    sudo mkdir -p ${APP_DIR}
                    sudo chown -R jenkins:jenkins ${APP_DIR}

                    sudo rsync -av --delete --exclude='.git' --exclude='node_modules' . ${APP_DIR}/

                    cd ${APP_DIR}
                    npm install
                    npm run build
                    sudo fuser -k ${PORT}/tcp || true
                """
            }
        }
    }

    post {
        always {
            echo "Pipeline run completed."
        }
        failure {
            echo "Deployment failed. Check Console Output for details."
        }
    }
}